---
// components
import Section from "../../elements/Section.astro";
import Text from "../../elements/Text.astro";
import Link from "../../elements/Link.astro";
import SocialLinks from "../../elements/SocialLinks.astro";
---

<Section
    aria-label="Contactarme"
    title="Contactarme"
    titleHeading="Si quieres contactarme aqui!"
>
    <div class="flex flex-col gap-16 text-base-400">
        <Text variant={'normal'}>Tienes alguna queja, reclamo o sugerencia? Contactame</Text>
        <Text variant={'normal'}>Correo electrónico: <Link variant="inline" href="jepalaciosv@unbosque.edu.co" text="jepalaciosv@unbosque.edu.co" />.</Text>
        <Text variant={'normal'}>O tambien puedes encontrame en redes sociales:</Text>    
    </div>
    
    <SocialLinks />
</Section>
